<?xml version="1.0" encoding="utf-8"?><!--
   백업·기기 이전 제외 규칙 (Android 12, API 31 이상).
   운전자 데이터(driver_session)와 업체 데이터(vendor_config)를 포함해 앱 데이터를 모두 제외한다.
   반납 때 지운 운전자 데이터가 복원되거나 다른 기기로 옮겨지지 않게 한다(결정 문서 4장 5번).
   allowBackup="false"만으로는 기기 간 이전(device-transfer)이 막히지 않으므로 이 규칙이 필요하다.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>